      "eventUrl": "grpcs://peer0.producer.supplychain.com:7053",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.producer.supplychain.com",
        "grpc.keepalive_time_ms": 600000
      },
      "tlsCACerts": {
        "path": "/opt/explorer/crypto-config/peerOrganizations/producer.supplychain.com/peers/peer0.producer.supplychain.com/tls/ca.crt"
      }
    }
  },
  "channels": {
