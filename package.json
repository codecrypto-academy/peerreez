    "next": "15.5.2",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/elliptic": "^6.4.18",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.13",
    "@types/react": "^19",
