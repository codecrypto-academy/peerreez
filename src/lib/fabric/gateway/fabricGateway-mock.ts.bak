import * as path from 'path';
import * as fs from 'fs';
import { Gateway, Wallets, Network, Contract, Wallet, X509Identity } from 'fabric-network';
import { Role, NetworkConnection, FabricError, ConnectionProfile } from '../../../types/fabric';
import { NETWORK_CONFIG } from '../config/network-config';
/**
 * Utility functions for Fabric SDK integration
 */
class FabricUtils {
    /**
     * Load connection profile for a specific organization
     */
    static async loadConnectionProfile(role: Role): Promise<ConnectionProfile> {
        try {
            const profilePath = path.join(__dirname, '../config/connection-profiles', `${role}.json`);
            
            if (!fs.existsSync(profilePath)) {
                throw new FabricError({
                    message: `Connection profile for ${role} not found at ${profilePath}`,
                    code: 'PROFILE_NOT_FOUND'
                });
            }

            const profileData = fs.readFileSync(profilePath, 'utf8');
            return JSON.parse(profileData) as ConnectionProfile;
        } catch (error) {
            console.error(`❌ Failed to load connection profile for ${role}:`, error);
            throw error;
        }
    }

    /**
     * Create or get wallet for a specific organization
     */
    static async getWallet(role: Role): Promise<Wallet> {
        try {
            const walletPath = path.join(__dirname, '../wallets', role);
            
            // Create wallet directory if it doesn't exist
            if (!fs.existsSync(walletPath)) {
                fs.mkdirSync(walletPath, { recursive: true });
            }

            const wallet = await Wallets.newFileSystemWallet(walletPath);
            console.log(`✅ Wallet created/loaded for ${role} at ${walletPath}`);
            return wallet;
        } catch (error) {
            console.error(`❌ Failed to create wallet for ${role}:`, error);
            throw new FabricError({
                message: `Failed to create wallet for ${role}`,
                code: 'WALLET_ERROR',
                details: error
            });
        }
    }

    /**
     * Create a user identity in the wallet
     */
    static async createUserIdentity(wallet: Wallet, userId: string, role: Role): Promise<void> {
        try {
            // Check if identity already exists
            const existingIdentity = await wallet.get(userId);
            if (existingIdentity) {
                console.log(`✅ Identity ${userId} already exists for ${role}`);
                return;
            }

            // For development, we'll create a mock identity
            // In production, this should be obtained from CA
            const identity: Identity = {
                credentials: {
                    certificate: await FabricUtils.getMockCertificate(role),
                    privateKey: await FabricUtils.getMockPrivateKey(role),
                },
                mspId: NETWORK_CONFIG.organizations[role],
                type: 'X.509',
            };

            await wallet.put(userId, identity);
            console.log(`✅ Created identity ${userId} for ${role}`);
        } catch (error) {
            console.error(`❌ Failed to create identity ${userId} for ${role}:`, error);
            throw error;
        }
    }

    /**
     * Get mock certificate for development (replace with real CA integration)
     */
    private static async getMockCertificate(role: Role): Promise<string> {
        // This is a simplified mock - in production you'd get this from CA
        const certPath = path.join(
            __dirname, 
            '../../../supply-chain-network/crypto-config/peerOrganizations',
            `${role}.supplychain.com/users/Admin@${role}.supplychain.com/msp/signcerts`
        );
        
        if (fs.existsSync(certPath)) {
            const certFiles = fs.readdirSync(certPath);
            if (certFiles.length > 0) {
                return fs.readFileSync(path.join(certPath, certFiles[0]), 'utf8');
            }
        }
        
        // Fallback mock certificate
        return `-----BEGIN CERTIFICATE-----\nMOCK_CERTIFICATE_FOR_${role.toUpperCase()}\n-----END CERTIFICATE-----`;
    }

    /**
     * Get mock private key for development (replace with real CA integration)
     */
    private static async getMockPrivateKey(role: Role): Promise<string> {
        // This is a simplified mock - in production you'd get this from CA
        const keyPath = path.join(
            __dirname, 
            '../../../supply-chain-network/crypto-config/peerOrganizations',
            `${role}.supplychain.com/users/Admin@${role}.supplychain.com/msp/keystore`
        );
        
        if (fs.existsSync(keyPath)) {
            const keyFiles = fs.readdirSync(keyPath);
            if (keyFiles.length > 0) {
                return fs.readFileSync(path.join(keyPath, keyFiles[0]), 'utf8');
            }
        }
        
        // Fallback mock private key
        return `-----BEGIN PRIVATE KEY-----\nMOCK_PRIVATE_KEY_FOR_${role.toUpperCase()}\n-----END PRIVATE KEY-----`;
    }
}

export class FabricGatewayManager {
    private gateway: Gateway | null = null;
    private wallet: Wallet | null = null;
    private currentRole: Role | null = null;
    private currentUserId: string | null = null;
    private static instance: FabricGatewayManager;

    private constructor() {
        // Singleton pattern
    }

    static getInstance(): FabricGatewayManager {
        if (!FabricGatewayManager.instance) {
            FabricGatewayManager.instance = new FabricGatewayManager();
        }
        return FabricGatewayManager.instance;
    }

    /**
     * Initialize wallet for a specific role
     */
    private async initializeWallet(role: Role): Promise<Wallet> {
        try {
            this.wallet = await FabricUtils.getWallet(role);
            return this.wallet;
        } catch (error) {
            console.error('❌ Failed to initialize wallet:', error);
            throw new FabricError({
                message: 'Failed to initialize Fabric wallet',
                code: 'WALLET_INIT_ERROR',
                details: error
            });
        }
    }

    async connectAsRole(role: Role, userId: string): Promise<NetworkConnection> {
        try {
            if (!this.wallet) {
                await this.initializeWallet();
            }

            // Check if user exists in wallet
            const userExists = await this.wallet!.get(userId);
            if (!userExists) {
                throw new Error(`User ${userId} not found in wallet. Please enroll first.`);
            }

            // Create gateway instance
            this.gateway = new MockGateway();

            // Get connection profile for role
            const connectionProfile = await this.loadConnectionProfile(role);

            // Gateway options (mock)
            const gatewayOptions = {
                wallet: this.wallet!,
                identity: userId,
                discovery: {
                    enabled: true,
                    asLocalhost: true
                },
                eventHandlerOptions: {
                    commitTimeout: 100,
                    strategy: null // Use default strategy
                }
            };

            // Connect to gateway
            await this.gateway.connect(connectionProfile, gatewayOptions);
            console.log(`✅ Connected to Fabric network as ${role}: ${userId}`);

            // Get network and contract
            const network = await this.gateway.getNetwork(NETWORK_CONFIG.channelName);
            const contract = network.getContract(NETWORK_CONFIG.chaincodeName);

            this.currentRole = role;

            return {
                gateway: this.gateway,
                network: network,
                contract: contract
            };

        } catch (error) {
            console.error(`❌ Failed to connect as ${role}:`, error);
            throw new FabricError({
                message: `Failed to connect to Fabric network as ${role}`,
                details: error
            });
        }
    }

    private async loadConnectionProfile(role: Role): Promise<object> {
        try {
            const profilePath = path.join(__dirname, '../config/connection-profiles', `${role}.json`);

            if (!fs.existsSync(profilePath)) {
                throw new Error(`Connection profile for ${role} not found at ${profilePath}`);
            }

            const profileData = fs.readFileSync(profilePath, 'utf8');
            return JSON.parse(profileData);
        } catch (error) {
            throw new FabricError({
                message: `Failed to load connection profile for ${role}`,
                details: error
            });
        }
    }

    async disconnect(): Promise<void> {
        try {
            if (this.gateway) {
                await this.gateway.disconnect();
                this.gateway = null;
                this.currentRole = null;
                console.log('✅ Disconnected from Fabric network');
            }
        } catch (error) {
            console.error('❌ Error disconnecting from gateway:', error);
        }
    }

    getCurrentRole(): Role | null {
        return this.currentRole;
    }

    isConnected(): boolean {
        return this.gateway !== null;
    }

    // Singleton pattern for browser environment
    private static instance: FabricGatewayManager | null = null;

    static getInstance(): FabricGatewayManager {
        if (!FabricGatewayManager.instance) {
            FabricGatewayManager.instance = new FabricGatewayManager();
        }
        return FabricGatewayManager.instance;
    }
}